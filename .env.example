# Токен бота из @BotFather
BOT_TOKEN=
# Адрес мини-приложения, попадает в кнопку бота
APP_URL=https://your-app.amvera.io/
# Секрет вебхука: сверяется с заголовком X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=
# 1 — разрешить игру без Telegram (для локальной отладки)
ALLOW_GUESTS=0
# Порт и постоянное хранилище
PORT=80
DATA_DIR=/data
